# /etc/toran/kiosk.env. Which device this Pi is, and where its Core is.
# install.sh writes this from its arguments; edit it and reboot to change.

# The device id in apps/web/src/fleet/devices.ts, dev-01 to dev-13.
TORAN_DEVICE=dev-01

# Toran Core on the hall LAN. Empty runs the kiosk on its own, with no fleet
# beat and cards kept on this machine only.
TORAN_CORE=http://192.168.1.10:8787

# CSS millimetres per real millimetre on this panel, from the ruler on /system.
# 1.471 is the 15.6 inch 1080p panel in the bill of materials.
TORAN_SCALE=1.471
