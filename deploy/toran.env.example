# Environment for the deployed hall. Copy to deploy/toran.env (Docker) or
# /etc/toran/core.env (systemd), fill in, and never commit the copy.

# The key a curator types into the Curator Console and the Twin. At least 16
# characters. Empty means the deployed hall is read only.
TORAN_CURATOR_KEY=

# The Research Assistant. Empty means it answers from its prepared answers.
GROQ_API_KEY=

# Spoken queries. Empty means no microphone is offered.
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=

# The simulated visitors. Set to 0 once real kiosks report in.
TORAN_SIMULATE_HALL=1

# The public address, when the hall is reached through a domain. Core then
# refuses cross-origin calls from anywhere else.
TORAN_CORE_ORIGINS=https://hall.example.org
