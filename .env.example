# Toran Core. Copy to .env.local and fill in. Never commit .env.local.

# Groq, the Research Assistant provider. Free tier, no card required.
# https://console.groq.com/keys
GROQ_API_KEY=

# Bhashini ULCA, Government of India language services.
# Register at https://bhashini.gov.in to obtain these.
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_INFERENCE_API_KEY=

# Toran Core base URL as seen by a kiosk. Empty means offline-only operation.
NEXT_PUBLIC_CORE_URL=

# The key a curator types into the Curator Console or the Twin to change a
# device or the archive. At least 16 characters. Empty means Core serves the
# hall read only. It is typed at the operator's desk and never ships to a kiosk.
# One way to make one: node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
TORAN_CURATOR_KEY=

# The simulated visitors that bring the Twin's hall to life. On unless this is
# 0. Every simulated device says so on its screen, and a real kiosk that
# reports in takes its device over.
TORAN_SIMULATE_HALL=1
