{
  "name": "toran",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @toran/web",
    "build": "npm run build --workspace @toran/web",
    "serve": "npm run serve --workspace @toran/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json}\"",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run verify:contrast && npm run verify:render && npm run verify:a11y && npm run verify:ingest && npm run verify:search && npm run verify:twin && npm run verify:kiosk && npm run verify:transition",
    "verify:contrast": "node tools/contrast-check.mjs",
    "verify:render": "node tools/verify-system.mjs",
    "verify:a11y": "node tools/a11y-check.mjs",
    "preview": "npx --yes serve@14 apps/web/out -l 4173",
    "ingest": "python3 pipeline/ingest.py",
    "verify:ingest": "python3 pipeline/verify.py",
    "build:index": "npm run build:index --workspace @toran/indexer",
    "vendor:model": "node packages/indexer/src/vendor-model.mjs",
    "verify:search": "node tools/benchmark-search.mjs",
    "verify:twin": "node tools/verify-twin.mjs",
    "verify:kiosk": "node tools/verify-kiosk.mjs",
    "verify:transition": "node tools/verify-transition.mjs",
    "shoot:twin": "node tools/shoot-twin.mjs",
    "build:ambient": "node tools/build-ambient.mjs",
    "test": "node --test apps/web/src/kiosk/machine.test.ts apps/web/src/kiosk/sensor/smooth.test.ts"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
